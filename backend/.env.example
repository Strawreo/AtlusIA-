# Copie este arquivo para .env e preencha a chave da Steam quando for integrar a API.
STEAM_API_KEY=

# Chave da API do TMDB (The Movie Database) para buscar capas/posters dos filmes.
# Obtenha em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Origens locais permitidas para acessar a API pelo navegador.
FRONTEND_ORIGINS=["http://localhost:5173"]
